NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://todo.example.com
APP_TIMEZONE=Asia/Shanghai
DATABASE_PATH=/var/lib/qetodo/qetodo.sqlite
UPLOAD_DIR=/var/lib/qetodo/uploads
BACKUP_DIR=/var/backups/qetodo
SESSION_TTL_DAYS=30
ADMIN_USERNAME=admin
# Only needed while creating or changing the initial account; remove it afterwards.
ADMIN_PASSWORD=replace-with-a-long-unique-password
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
